# Multi-stage production build for the Next.js app (Next 15, standalone output).
# Build: docker build -t expense-frontend .
# Run:   docker run -p 3000:3000 expense-frontend

# --- deps: install node_modules from the manifest only (cached layer) ---
FROM node:22-alpine AS deps
WORKDIR /app

# package-lock.json (generated by `npm install`) is preferred; `npm install`
# is the fallback while the lockfile is not committed yet.
COPY package.json package-lock.json* ./
RUN npm ci || npm install

# --- builder: compile the standalone server bundle ---
FROM node:22-alpine AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
# NEXT_PUBLIC_API_URL is inlined at build time; when unset the app falls back
# to http://localhost:8000, which is what a host browser needs against the
# published FastAPI port.
RUN npm run build

# --- runner: minimal runtime image ---
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# public/ (hosts vendoring-free static assets; kept copy requires the dir to
# exist), the standalone server and the static client assets.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
