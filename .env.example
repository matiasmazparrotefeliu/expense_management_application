# DB_URL tiene prioridad. Con SQLite: sqlite:///./expense_app.db
# Con MySQL: mysql+pymysql://user:pass@host:port/dbname
DB_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Usado por el contenedor docker (docker-compose.yaml). En local el default aplica.
SECRET_KEY=

# IA para extracción de comprobantes (endpoint OpenAI-compatible, ej. OpenCode Zen).
# API_KEY se agrega manualmente; sin estas vars POST /operations/from-receipt devuelve 503.
API_URL=https://opencode.ai/zen/v1
API_KEY=
AI_MODEL=deepseek-v4-flash-free

# URL del frontend para CORS. Se usa en docker-compose.yaml y backend/main.py.
FRONTEND_URL=http://localhost:3000
