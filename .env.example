# Entorno de ejecución: dev (SQLite local) | prod (PostgreSQL en Render)
APP_ENV=dev

# DB_URL tiene prioridad; en prod también se acepta DATABASE_URL (nombre estándar de Render).
# DEV (SQLite): sqlite:///./expense_app.db
# PROD (Postgres Render, INTERNAL Database URL): postgresql://user:pass@host:5432/dbname
DB_URL=
DATABASE_URL=
# Solo para conexiones externas (Render External URL): sslmode=require
DB_SSL_MODE=

# Legacy: solo se usan si no hay DB_URL/DATABASE_URL y APP_ENV != prod.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Usado por el contenedor docker (docker-compose.yaml). En local el default aplica.
SECRET_KEY=

# IA para carga de operaciones por relato de texto (endpoint OpenAI-compatible, ej. OpenCode Zen).
# API_KEY se agrega manualmente; sin estas vars POST /operations/from-text devuelve 503.
API_URL=https://opencode.ai/zen/v1
API_KEY=
AI_MODEL=deepseek-v4-flash-free

# URL del frontend para CORS. Se usa en docker-compose.yaml y backend/main.py.
FRONTEND_URL=http://localhost:3000
